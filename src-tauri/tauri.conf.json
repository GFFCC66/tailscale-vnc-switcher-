{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VNC Switcher",
  "version": "0.1.0",
  "identifier": "app.vncswitcher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "云桌面切换",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#0c0e11"
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* ws://localhost:* wss: https:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' blob:; worker-src 'self' blob:; frame-src http: https: blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
